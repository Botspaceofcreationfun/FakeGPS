    <string name="settings_mock_help_title">Mock-location help</string>
    <string name="settings_mock_help_body">The app injects locations through Android\'s official mock-location mechanism, which requires you to select this app once:</string>
    <string name="settings_mock_step1">1. Open your device Settings → About phone.</string>
    <string name="settings_mock_step2">2. Tap “Build number” 7 times until “You are now a developer” appears.</string>
    <string name="settings_mock_step3">3. Open System → Developer options (the path varies by device).</string>
    <string name="settings_mock_step4">4. Find “Select mock location app” and choose “GPS Fake Pro”.</string>
    <string name="settings_mock_step5">5. Return here and start a simulation.</string>
    <string name="settings_mock_note">Some manufacturers rename this setting (“Allow mock locations”, “Mock location”, …). If it is missing, your build does not support mock location.</string>
    <string name="settings_about_title">About</string>
    <string name="settings_about_body">Ad-free, analytics-free mock-location simulator for testing location-dependent apps. Uses OpenStreetMap (osmdroid) tiles and Android\'s official mock-location API. Route legs are straight lines between waypoints — they do not follow real roads.</string>
